{
  "entities": {
    "User": {
      "title": "User",
      "description": "An agent using the portal.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID" },
        "email": { "type": "string", "description": "User email address" },
        "name": { "type": "string", "description": "User display name" },
        "role": { "type": "string", "description": "User role, e.g., 'agent'" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time", "description": "Timestamp measuring when the user is last active online" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Upload": {
      "title": "Upload",
      "description": "A record of a raw file uploaded by an agent.",
      "type": "object",
      "properties": {
        "agentId": { "type": "string", "description": "ID of the agent who uploaded" },
        "filename": { "type": "string", "description": "Name of the uploaded file" },
        "totalAmount": { "type": "number", "description": "Total amount in the file" },
        "totalAccounts": { "type": "number", "description": "Total number of accounts" },
        "status": { "type": "string", "description": "Status of the upload, e.g., 'processed'" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["agentId", "filename", "totalAmount", "totalAccounts", "status", "createdAt"]
    },
    "Batch": {
      "title": "Batch",
      "description": "A lot of up to ₹20,000 for the Python script to process.",
      "type": "object",
      "properties": {
        "agentId": { "type": "string", "description": "ID of the agent who owns this batch" },
        "uploadId": { "type": "string", "description": "ID of the upload this batch belongs to" },
        "totalAmount": { "type": "number", "description": "Total amount in this batch (<= 20000)" },
        "accountCount": { "type": "number", "description": "Number of accounts in this batch" },
        "status": { "type": "string", "description": "Status, e.g., 'pending', 'processing', 'completed', 'failed'" },
        "referenceNumber": { "type": "string", "description": "The reference number generated by the DOP portal" },
        "batchNumber": { "type": "number", "description": "The sequential number of the batch" },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accountNo": { "type": "string" },
              "amount": { "type": "number" }
            },
            "required": ["accountNo", "amount"]
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["agentId", "uploadId", "totalAmount", "accountCount", "status", "accounts", "createdAt"]
    },
    "LotCustomer": {
      "title": "LotCustomer",
      "description": "An RD account managed by the agent for lot making.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "accountNo": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "accountNo", "name", "amount", "createdAt"]
    },
    "Checklist": {
      "title": "Checklist",
      "description": "A saved list of lot groupings.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "TaskBlock": {
      "title": "TaskBlock",
      "description": "A block of accounts in a checklist.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "checklistId": { "type": "string" },
        "groupNumber": { "type": "number" },
        "accountsText": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "checklistId", "groupNumber", "accountsText", "isCompleted", "createdAt", "updatedAt"]
    },
    "LoginHistory": {
      "title": "LoginHistory",
      "description": "A record of an agent logging into the portal.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "loginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "loginAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global site settings for About Us and Contact.",
      "type": "object",
      "properties": {
        "aboutUsText": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "youtube": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["aboutUsText", "address", "email", "phone", "whatsapp", "youtube", "updatedAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Messages from users via Contact Us form.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["unread", "read"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global configuration settings"
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Contact messages submitted by users"
    },
    "/login_history/{historyId}": {
      "schema": { "$ref": "#/entities/LoginHistory" },
      "description": "Records of all agent login actions"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores agent profiles."
    },
    "/uploads/{uploadId}": {
      "schema": { "$ref": "#/entities/Upload" },
      "description": "Stores metadata about uploaded files."
    },
    "/batches/{batchId}": {
      "schema": { "$ref": "#/entities/Batch" },
      "description": "Stores the ₹20,000 lots."
    },
    "/lot_customers/{customerId}": {
      "schema": { "$ref": "#/entities/LotCustomer" },
      "description": "Stores individual RD accounts for lot generation."
    },
    "/checklists/{checklistId}": {
      "schema": { "$ref": "#/entities/Checklist" },
      "description": "Stores user checklists."
    },
    "/task_blocks/{taskId}": {
      "schema": { "$ref": "#/entities/TaskBlock" },
      "description": "Stores task blocks for a checklist."
    }
  }
}
